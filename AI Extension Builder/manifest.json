{
  "manifest_version": 3,
  "name": "Extension AI Builder",
  "version": "1.0.0",
  "description": "Build Chrome extensions from natural-language prompts using AI.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Extension AI Builder",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "options_page": "settings.html"
}
